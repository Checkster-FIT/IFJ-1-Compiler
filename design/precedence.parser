
                       [(] [t] [)] [!] [*] [+] [<] [=] [&] [|] [$] [.]
     [(]              | < | < | = | < | < | < | < | < | < | < | ? | < |
     [t]              | ? | ? | > | ? | > | > | > | > | > | > | > | > |
     [)]              | ? | ? | > | ? | > | > | > | > | > | > | > | > |
     [!, +u, -u]      | < | < | > | < | > | > | > | > | > | > | > | < |
     [*, /]           | < | < | > | < | > | > | > | > | > | > | > | < |
     [+, -]           | < | < | > | < | < | > | > | > | > | > | > | < |
     [<, <=, >, >=]   | < | < | > | < | < | < | ? | > | > | > | > | < |
     [==, !=]         | < | < | > | < | < | < | < | ? | > | > | > | < |
     [&&]             | < | < | > | < | < | < | < | < | > | > | > | < |
     [||]             | < | < | > | < | < | < | < | < | < | > | > | < |
     [$]              | < | < | ? | < | < | < | < | < | < | < | ? | < |
     [.]              | ? | < | > | ? | > | > | > | > | > | > | > | > |

// ---------------------------------------------------------------------

    <E> -> ()
    <E> -> [t]
    <E> -> (<E>)
    <E> -> <E>.<E>
    <E> := +<E>, -<E>, !<E>
    <E> := <E>*<E>, <E>/<E>, <E>+<E>, <E>-<E>
    <E> := <E><<E>, <E><=<E>, <E>><E>, <E>>=<E>, <E>==<E>, <E>!=<E>, <E>&&<E>, <E>||<E>

// ---------------------------------------------------------------------

    [+, -, !] := right associativity
    [*, /, +, -] := left associativity
    [<, <=, >, >=, ==, !=] := no associativity
    [.] := left associativity
    [&&, ||] := left associativity (?)

// ---------------------------------------------------------------------

    t
    .
    ()
    !, +u, -u
    *, /
    +, -
    <, <=, >, >=
    ==, !=
    &&
    ||