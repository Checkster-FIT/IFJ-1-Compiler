
<program> -> [LF] <program>
<program> -> <header> <body> // TODO: Require newline after header?
<header> -> import [IDENTIFIER] . *

<body> -> [LF] <body>
<body> -> [EOF]
<body> -> <function> <body>
<body> -> <extension> <body>
<body> -> @main <function> <body>
// Parameterless requirement for the main function will be checked in the semantic analysis

    // -------------------------------------------------
    <extension> -> extension + ( + <param> + ) + [LF] + [INDENT] + <extension_body>

        <extension_body> -> <function> + <extension_body>
        <extension_body> -> [DEDENT]

    // -------------------------------------------------

    <function> -> def [IDENTIFIER] <param_group_list> <type_specifier> = <function_body>

        <type_specifier> -> : <type>
        <type_specifier> -> 3

        <type> := String, Int, Double, Unit, Boolean

    <param_group_list> -> ( <param_list_first> ) <param_group_list>
    <param_group_list> -> 3

        <param_list_first> -> <param> <param_list>
        <param_list_first> -> 3

        <param_list> -> , <param> <param_list>
        <param_list> -> 3

            <param> -> [IDENTIFIER] : <type>

    // -------------------------------------------------

    <function_body> -> [LF] [INDENT] <statement_list> [DEDENT]
    <function_body> -> <EXPR> [LF]

    <statement_list> -> <statement> [LF] <statement_list> // Add ';' as a separator
    <statement_list> -> <construct> <statement_list>
    <statement_list> -> 3

        <statement> := <st_vardef>, <st_assign>, <st_return>, <EXPR>

            // <st_assign> needs to look into the future?
            // [identifier] that is not followed by '=' is an expression
            <st_assign> ->     [IDENTIFIER]                  = <EXPR>

            <st_vardef> -> val [IDENTIFIER] <type_specifier> = <EXPR>
            <st_vardef> -> var [IDENTIFIER] <type_specifier> = <EXPR>
            <st_return> -> return <EXPR>

        <construct> := <c_while> <c_if_then> <c_for>

            <c_while> -> while <REL_EXPR> do [LF] [INDENT] <statement_list> [DEDENT]
            <c_if_then> -> if <REL_EXPR> then [LF*] [INDENT*] <statement_list> [DEDENT*] <else_branch>
            <c_else> -> else [LF*] [INDENT*] <statement_list> [DEDENT*]
            <c_for> -> ???

    // -------------------------------------------------

    <EXPR> -> ...
    <REL_EXPR> -> ...