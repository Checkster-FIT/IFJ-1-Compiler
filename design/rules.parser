
<program> -> [LF] <program>
<program> -> <header> <body> // TODO: Require newline after header?
<header> -> import [IDENTIFIER] . *

<body> -> [LF] <body>
<body> -> [EOF]
<body> -> <function> <body>
<body> -> <extension> <body>
<body> -> @main <function> <body>
// Parameterless requirement for the main function will be checked in the semantic analysis

    // -------------------------------------------------
    <extension> -> extension + ( + <param> + ) + [LF] + [INDENT] + <extension_body>

        <extension_body> -> <function> + <extension_body>
        <extension_body> -> [DEDENT]

    // -------------------------------------------------

    <function> -> def [IDENTIFIER] <param_group_list> <type_specifier> = <function_body>

        <type> := String, Int, Double, Unit, Boolean

        <param_group_list> -> ( <param_first> ) <param_group_list>
        <param_group_list> -> 3

            <param_first> -> <param> <param_list>
            <param_first> -> 3

            <param_list> -> , <param> <param_list>
            <param_list> -> 3

                <param> -> [IDENTIFIER] : <type>

        <type_specifier> -> : <type>
        <type_specifier> -> 3

    // -------------------------------------------------

        <function_body> -> [LF] [INDENT] <statement_list>
        <function_body> -> <EXPRESSION> [LF]

        <statement_list> -> <statement> <statement_list>
        <statement_list> -> [DEDENT]

            <statement> := <st_vardef>, <st_assign>, <st_conditional>, <st_while>, <st_return>

            <st_vardef> -> val [IDENTIFIER] <type_specifier> = <EXPRESSION> [LF]
            <st_vardef> -> var [IDENTIFIER] <type_specifier> = <EXPRESSION> [LF]

            <st_assign> -> [IDENTIFIER] = <EXPRESSION> [LF]
            <st_return> -> return <EXPRESSION> [LF]

    // -------------------------------------------------

            <st_while> -> while <RELATIONAL_EXPRESSION> do [LF] [INDENT] <statement_list> [DEDENT]

            <st_conditional> -> <if_then> <else_if_list> <else>

            // This statement LF and dedent needs to be replaced (second statement list?)
            <if_then> -> if <RELATIONAL_EXPRESSION> then [LF*] [INDENT*] <statement_list> [DEDENT]

            <else_if_list> -> else <if_then> <else_if_list>
            <else_if_list> -> 3

            <else_if_list> -> else [LF*] [INDENT*] <statement_list> [DEDENT]
            <else_if_list> -> 3

    // -------------------------------------------------
