
<program> -> [LF] <program>
<program> -> <header> <body>
<header> -> import [IDENTIFIER] . *

    <body> -> [LF] <body>
    <body> -> [EOF]
    <body> -> <function> <body>
    <body> -> @main <function> <body>
    // Parameterless requirement for the main function will be checked in the semantic analysis

        // -------------------------------------------------

        <function> -> def [IDENTIFIER] <param_group_list> <type_specifier> = <function_body>

            <type> := String, Int, Double, Unit, Boolean

            <param_group_list> -> ( <param_first> ) <param_group_list>
            <param_group_list> -> 3

                    <param_first> -> <param> <param_list>
                    <param_first> -> 3

                    <param_list> -> , <param> <param_list>
                    <param_list> -> 3

                        <param> -> [IDENTIFIER] : <type>

            <type_specifier> -> : <type>
            <type_specifier> -> 3

        // -------------------------------------------------

            <function_body> -> [INDENT] <statement_list>

                <statement_list> -> <statement> <statement_list>
                <statement_list> -> [UNINDENT]

                    <statement> -> <statement> LF
                    <statement> := <st_vardef>, <st_assign>

                <st_vardef> -> val [IDENTIFIER] <type_specifier> = <expression>
                <st_vardef> -> var [IDENTIFIER] <type_specifier> = <expression>

                <st_assign> -> [IDENTIFIER] = <expression>

        // -------------------------------------------------



