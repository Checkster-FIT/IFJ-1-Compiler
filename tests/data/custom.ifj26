import ifj26.*

def factorial(n: Int): Int =
    var result = 1 + (n * 8)
    var i: Int = n
    while i > 1 do
        result = result * i
        i = i - 1
    if i == 42 then
        // return -42
        return 42
    result

def pi_string() =
    3.14159265359.toString

